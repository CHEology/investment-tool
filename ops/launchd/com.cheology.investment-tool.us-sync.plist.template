<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cheology.investment-tool.us-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>investment_tool.cli</string>
    <string>us-sync-daily</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__REPO__/src</string>
  </dict>
  <!-- daily at 19:30 local; the catch-up design makes the exact hour
       non-critical: every run re-syncs whatever recent filing days are
       still missing, so a missed tick heals on the next one -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>19</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__REPO__/data/audit/soak/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/audit/soak/launchd.err.log</string>
</dict>
</plist>
