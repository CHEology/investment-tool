# Copy to .env (gitignored). Never commit real values.

# Data directory (SQLite, raw store, artifacts). Default: ./data
INVESTMENT_TOOL_DATA_DIR=data

# --- S2+ (US filings ingestion; decision D3) ---
# SEC fair-access policy requires an identifying User-Agent:
#   "Name (contact)" e.g. "Jane Doe Research jane@example.com"
# The EDGAR adapter refuses to start with a placeholder.
SEC_USER_AGENT=

# --- A-share spine (decision D2) ---
# Preferred storage is macOS Keychain service "investment-tool-tushare";
# the env var is the fallback for non-macOS hosts.
TUSHARE_TOKEN=

# EODHD key lives in macOS Keychain service "investment-tool-eodhd" (S2).
